# Copy to .env and replace the placeholders. .env is gitignored - never commit it.
# On Portainer, set the same variables in the stack environment instead.

# PostgreSQL - used by the db container and by the app to connect.
POSTGRES_USER=seismo
POSTGRES_PASSWORD=change-me
POSTGRES_DB=seismo

# Admin login of the dashboard - only the api container gets these.
ADMIN_USERNAME=admin
# At least 12 characters.
ADMIN_PASSWORD=change-me
# At least 32 characters, e.g. from: openssl rand -hex 32
# Changing it or the admin password logs out every open session.
SESSION_SECRET=change-me

# Optional - the values shown are the defaults.
# How a news source can reach you, sent in the User-Agent of every fetch. Polite, and some sources ask
# for it: www.admin.ch (BFS) refuses full texts without one; SEC and BLS want an e-mail address, not a URL.
FETCH_CONTACT=
# The appname ReliefWeb approved for its API (README.md); empty: ReliefWeb Quellen fail with a message.
RELIEFWEB_APPNAME=
LOG_LEVEL=INFO
# The LLM server for the event extraction, e.g. http://192.168.1.20:11434; empty: no extraction. The dev
# stack has its own (README.md). The model must be pulled on that server; the context is in tokens.
OLLAMA_BASE_URL=
OLLAMA_MODEL=qwen3.5:9b
OLLAMA_NUM_CTX=8192
WORKER_POLL_INTERVAL_SECONDS=5
# Port of the api on the host.
API_PORT=8000
# true only once the api is served over HTTPS; browsers never send the cookie over plain HTTP then.
SESSION_COOKIE_SECURE=false
# Backups go to the Docker volume db-backups. An absolute host path instead, e.g. a mounted NAS share,
# keeps them off this host's disk; the folder must be writable for user id 10001 (README.md, "Backups").
# BACKUP_HOST_DIR=/mnt/nas/seismo-backups
