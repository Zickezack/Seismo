# Copy to .env and replace the placeholders. .env is gitignored - never commit it.
# On Portainer, set the same variables in the stack environment instead.

# PostgreSQL - used by the db container and by the app to connect.
POSTGRES_USER=finnewsint
POSTGRES_PASSWORD=change-me
POSTGRES_DB=finnewsint

# Optional - the values shown are the defaults.
LOG_LEVEL=INFO
WORKER_POLL_INTERVAL_SECONDS=5
# Port of the api on the host.
API_PORT=8000
